{
  "regions": ["bom1"],
  "functions": {
    "api/proxy.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/notifications/daily-reminder",
      "schedule": "30 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/cybervidya/:path*",
      "destination": "/api/proxy?path=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
